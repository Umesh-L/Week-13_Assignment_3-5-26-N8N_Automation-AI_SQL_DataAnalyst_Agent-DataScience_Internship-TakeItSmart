    {
      "parameters": {
        "promptType": "define",
        "text": "=Generate a comprehensive blog article based on this AI news summary:\n\n{{ $json.output }}\n\nCreate an engaging blog post with:\n- A catchy title wrapped in <h1> tags\n- An introduction paragraph in <p> tags\n- Each news item as a section with <h2> heading and <p> content\n- Analysis section with <h2> heading\n- A conclusion with <h2> heading and <p> content\n- Use <strong> for emphasis and <br> for line breaks where needed\n\nFormat the entire output as clean HTML that will render beautifully in an email. Make it informative, professional, and engaging for tech-savvy readers.",
        "options": {
          "systemMessage": "You are an expert tech blogger specializing in AI and technology. Write engaging, well-structured blog posts in HTML format that inform and captivate readers. Use proper HTML tags: <h1> for main title, <h2> for section headings, <p> for paragraphs, <strong> for bold text, and <br> for line breaks. Ensure the HTML is clean and email-friendly."
        }
      },
      "id": "eaf3e829-c123-4f80-9567-f8e06ef0e7f0",
      "name": "Blog Generator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        816,
        304
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "subject",
              "type": "string",
              "value": "=AI News Digest - {{ $now.toFormat(\"MMMM d, yyyy\") }}"
            },
            {
              "id": "2",
              "name": "body",
              "type": "string",
              "value": "={{ $json.output }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3a353748-829c-4308-bc9c-8780d82876e7",
      "name": "Format Email",
