    {
      "parameters": {
        "promptType": "define",
        "text": "Search for the latest AI news from today using the SerpApi News Search tool. Focus on major developments, breakthroughs, and trending topics in artificial intelligence. Return the top 5 most important news items with their titles, sources, and brief descriptions.",
        "options": {
          "systemMessage": "You are an AI news researcher. Your task is to find the latest and most important AI news using the SerpApi News Search tool. Always use the tool to get current information - do not rely on your training data. Format your findings clearly with titles, sources, and descriptions."
        }
      },
      "id": "9c7f125e-3f44-49f3-972a-b69521da75a5",
